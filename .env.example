# =============================================================================
# GovChat-NL — .env.example
# Kopieer dit bestand naar .env en vul de waarden in.
# Commit nooit je .env naar Git.
#
# Genereer willekeurige sleutels via: openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — OpenWebUI database
# -----------------------------------------------------------------------------
OWUI_POSTGRES_DB=openwebui
OWUI_POSTGRES_USER=openwebui
OWUI_POSTGRES_PASSWORD=vervang-met-sterk-wachtwoord

# -----------------------------------------------------------------------------
# Qdrant — vector database
# Gebruik dezelfde sleutel als QDRANT__SERVICE__API_KEY in de container.
# -----------------------------------------------------------------------------
QDRANT_API_KEY=vervang-met-willekeurige-sleutel

# -----------------------------------------------------------------------------
# LiteLLM — modelrouter
#
# LITELLM_MASTER_KEY:  hoofdsleutel voor de proxy, gebruik sk- als prefix.
#                      OpenWebUI gebruikt deze sleutel als OPENAI_API_KEY.
# LITELLM_SALT_KEY:    willekeurige string voor interne hashing van sleutels.
# LITELLM_UI_USERNAME: inlognaam voor de LiteLLM-beheerpagina.
# LITELLM_UI_PASSWORD: wachtwoord voor de LiteLLM-beheerpagina.
# LITELLM_PORT:        poort waarop LiteLLM extern bereikbaar is (standaard 4000).
# -----------------------------------------------------------------------------
LITELLM_POSTGRES_PASSWORD=vervang-met-sterk-wachtwoord
LITELLM_MASTER_KEY=sk-vervang-met-willekeurige-sleutel
LITELLM_SALT_KEY=vervang-met-willekeurige-string
LITELLM_UI_USERNAME=litellmadmin
LITELLM_UI_PASSWORD=vervang-met-sterk-wachtwoord
LITELLM_PORT=4000
LITELLM_LOG_LEVEL=WARNING
LITELLM_NUM_WORKERS=1
LITELLM_DB_POOL_LIMIT=10
LITELLM_DB_TIMEOUT=30

# -----------------------------------------------------------------------------
# OpenWebUI — gebruikersinterface
#
# WEBUI_SECRET_KEY:       willekeurige string voor sessie- en tokensigning.
# WEBUI_DOMAIN:           publiek domein van de installatie, zonder https://.
# WEBUI_NAME:             naam bovenin de interface.
# WEBUI_WELCOME_MESSAGE:  welkomstbericht op het lege chatscherm.
# WEBUI_LOGIN_SUBTITLE:   ondertitel op het loginscherm.
# OPENWEBUI_PORT:         poort waarop OpenWebUI extern bereikbaar is.
# -----------------------------------------------------------------------------
WEBUI_SECRET_KEY=vervang-met-willekeurige-string
WEBUI_DOMAIN=openwebui.jouworganisatie.nl
WEBUI_NAME=GovChat-NL
WEBUI_WELCOME_MESSAGE=Welkom bij GovChat-NL
WEBUI_LOGIN_SUBTITLE=Jouw AI assistent
OPENWEBUI_PORT=8080

# -----------------------------------------------------------------------------
# Microsoft Entra ID SSO
#
# Maak een App Registration aan in de Azure Portal:
#   1. Ga naar Azure Active Directory > App registrations > New registration
#   2. Stel de Redirect URI in: https://${WEBUI_DOMAIN}/oauth/microsoft/callback
#   3. Voeg API permissions toe: openid, email, profile, GroupMember.Read.All
#   4. Maak een Client Secret aan en kopieer de waarde hieronder
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=vervang-met-client-secret
MICROSOFT_CLIENT_TENANT_ID=00000000-0000-0000-0000-000000000000
